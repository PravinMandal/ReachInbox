# Copy to .env and fill. Real secrets come from you at the end — never commit .env.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ES_NODE=http://localhost:9200

JWT_SECRET=change-me-to-32-plus-characters-minimum-xxxx
ENCRYPTION_KEY=change-me-32-bytes-minimum-passphrase!!

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-side Google login: Google calls this back with ?code=. Must also be
# listed under Authorized redirect URIs in the Google console.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Outbound auth mail (verification links must reach real inboxes — Gmail OAuth2).
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_DEFAULT_CHANNEL_ID=

WORKER_CONCURRENCY=5
MIN_GAP_MS=2000
MAX_EMAILS_PER_HOUR_GLOBAL=200
STALE_SENDING_MINUTES=5
ETHEREAL_POOL_SIZE=2

# Live (Vercel) only — guard for POST /api/worker/tick (Vercel Cron).
CRON_SECRET=

# Local UI work without Google creds (dev only, NEVER enable in prod).
DEV_AUTH_BYPASS=false
DEV_USER_EMAIL=oliver.brown@domain.io

# --- Live $0 map (fill when deploying) ---
# DATABASE_URL=postgresql://...neon.tech/...?pgbouncer=true&connection_limit=1
# REDIS_URL=rediss://default:...@...upstash.io:6379   (TCP only — never REST)
# ES_NODE=https://...bonsai.io  (or leave unset → Postgres fallback)
# FRONTEND_URL=https://<web>.vercel.app
# SLACK_REDIRECT_URI=https://<api>.vercel.app/api/slack/callback
