{
  "name": "@reachinbox/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "db:generate": "prisma generate",
    "reindex": "tsx scripts/reindex.ts",
    "bulk-schedule": "tsx scripts/bulk-schedule.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.11.0",
    "@bull-board/express": "^5.11.0",
    "@bull-board/ui": "^5.23.0",
    "@elastic/elasticsearch": "^8.15.0",
    "@prisma/client": "^5.18.0",
    "@reachinbox/shared": "*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.4.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^9.14.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pino": "^9.3.2",
    "pino-http": "^10.1.0",
    "sanitize-html": "2.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.18.0",
    "supertest": "^7.3.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^5.0.2"
  }
}
